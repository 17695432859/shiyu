{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shiyu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "ShiyuContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHIYU_CONTAINER",
        "class_name": "ShiyuContainer"
      }
    ]
  },
  "exports": {
    "ShiyuContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
